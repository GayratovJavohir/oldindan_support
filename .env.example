# Backend asosiy manzili. Bo'sh qoldirilsa — joriy origin (dev'da Vite proxy, prod'da reverse proxy).
# Frontend va backend alohida domenda bo'lsa: https://api.example.com
VITE_API_URL=

# JWT refresh endpoint yo'li (VITE_API_URL dan keyin). Backendingizdagi haqiqiy yo'lni qo'ying.
VITE_REFRESH_PATH=/api/accounts/token/refresh/

# Django Channels WS asosi (oxiriga /<ticket_id>/<audience>/ o'zi qo'shiladi).
# Bo'sh qoldirilsa VITE_API_URL yoki joriy host'dan olinadi: ws(s)://<host>/ws/support
VITE_SUPPORT_WS_URL=
